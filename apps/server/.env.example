# Reference inventory only. The server reads process environment variables and
# does not automatically load this file; export values or use a dotenv runner.
PORT=4000
DATA_DIR=.data/arielcharts
CLEANUP_INTERVAL_MS=30000
SESSION_TTL_MS=300000
DISK_TTL_MS=604800000
# Local browser origin. Production: https://arielcharts.donovanyohan.com
ALLOWED_ORIGINS=http://localhost:3000
# Required in production; generate a unique, long random secret and do not commit it.
ROOM_COOKIE_SECRET=replace-with-a-long-random-secret
ROOM_COOKIE_TTL_MS=28800000
# Local defaults. Canonical Fly production uses ROOM_COOKIE_SECURE=true,
# ROOM_COOKIE_SAME_SITE=Lax, and CLIENT_ADDRESS_PROFILE=fly. No forwarded
# header is trusted locally.
ROOM_COOKIE_SECURE=false
ROOM_COOKIE_SAME_SITE=Lax
CLIENT_ADDRESS_PROFILE=none
# TRUST_PROXY is deliberately unsupported. Do not set it; select the explicit
# CLIENT_ADDRESS_PROFILE above instead.
# ROOM_ACCESS_CRYPTO_PROFILE=test is E2E-only and permitted only with
# NODE_ENV=test. Never add it to local or production deployment configuration.
# Fly production pins this to 2 because each scrypt worker uses roughly 128 MiB.
# Do not increase it on the single machine. Local Node may keep its default.
# UV_THREADPOOL_SIZE=2
