# Reference only: normal workspace commands do not load this file directly.
# Put browser variables in apps/web/.env.local. Export server variables in the
# shell (or use a dotenv runner) because apps/server does not load .env files.
# These are the matching local endpoint defaults.
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000
